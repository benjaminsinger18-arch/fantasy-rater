PORT=3001

# AI
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Clerk (Backend) — get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# Stripe — get from https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Create a Product + Price in Stripe dashboard, copy the price ID (price_...)
STRIPE_PRO_PRICE_ID=price_...
# Webhook signing secret — from Stripe dashboard → Webhooks → your endpoint → Signing secret
# Register endpoint: POST https://your-railway-url/api/billing/webhook
# Events to listen for: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# URL of your deployed frontend (used for Stripe redirect URLs and CORS)
CLIENT_URL=https://fantasy-rater.vercel.app

# Yahoo OAuth (register at developer.yahoo.com)
YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret
YAHOO_REDIRECT_URI=http://localhost:3001/api/auth/yahoo/callback
